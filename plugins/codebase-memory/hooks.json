{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/lifecycle_context.sh\" --harness copilot --event SessionStart",
        "powershell": "& \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" lifecycle_context.sh --harness copilot --event SessionStart",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/lifecycle_context.sh\" --harness copilot --event SubagentStart",
        "powershell": "& \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" lifecycle_context.sh --harness copilot --event SubagentStart",
        "timeoutSec": 5
      }
    ]
  }
}
