{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 hooks/session_start_context.py --harness copilot --event SessionStart",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 hooks/handoff-token-flag.py --mode stop",
        "timeoutSec": 5
      }
    ]
  }
}
