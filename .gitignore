# generic
*.local
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
node_modules/
*.egg-info/
# install-provenance stamps (e.g. agent-workbench's) — machine-local, not config
.installed-by-*

# ---- .claude ---- (migrated verbatim from dotfiles' .gitignore, lines 13-18 + 39-54)
# Global CLAUDE.md is personal, machine-local instruction — deployed by stow,
# never tracked.
.claude/CLAUDE.md
.claude/*local*
.claude/**/*local*
.claude/settings.json
# .stow-local-ignore is stow's package-level ignore file — DO track it.
!.claude/.stow-local-ignore
.claude/plans
.claude/projects
# claude-code runtime state (written into ~/.claude/ at runtime; never tracked)
.claude/.credentials.json
.claude/cache/
.claude/debug/
.claude/history.jsonl
.claude/plugins/
.claude/session-env/
.claude/statsig/
.claude/todos/
.claude/backups/
.claude/file-history/
.claude/sessions/
.claude/shell-snapshots/
.claude/mcp-needs-auth-cache.json

# ---- .hermes ---- (migrated verbatim from dotfiles' .gitignore, lines 71-94)
.hermes/.env
.hermes/.env.local
.hermes/state.db
.hermes/sessions/
.hermes/memory/
.hermes/pipeline-registry.json
.hermes/*local*
# .stow-local-ignore is stow's package-level ignore file — DO track it.
!.hermes/.stow-local-ignore
.hermes/channel_directory.json
.hermes/cron/
.hermes/kanban.db
.hermes/kanban.db-shm
.hermes/kanban.db-wal
# Local-only live config; SOUL.md identity files are static and tracked.
.hermes/config.yaml
.hermes/profiles/*/config.yaml
.hermes/profiles/*/.env
.hermes/profiles/*/state.db
.hermes/profiles/*/sessions/
.hermes/profiles/*/memory/
.hermes/profiles/*/logs/
.hermes/profiles/*/auth.json

# ---- opencode ---- (migrated from dotfiles' .gitignore, lines 19-34;
# opencode/opencode.json stays tracked — dotfiles unignored it at line 64,
# reproduced below)
opencode/projects/*
!opencode/projects/.gitkeep
opencode/plans/*
!opencode/plans/.gitkeep
opencode/memory/*
!opencode/memory/.gitkeep
opencode/agents/memory/*
!opencode/agents/memory/.gitkeep
opencode/agents/shared/agent-models.local.json
opencode/agents/shared/model-map.local.md
opencode/inbox/
opencode/opencode.json
opencode/models.local
messages.md
configstore
uv
!/opencode/opencode.json

# ---- .codex ----
# ~/.codex is ~155M of live runtime plus auth.json (OAuth creds) and
# config.toml (a machine-local trust ledger that churns). Ignore-everything-
# then-unignore beats an ever-growing denylist. Never tracked, at any depth:
# auth.json, config.toml, *.sqlite/*.sqlite-shm/*.sqlite-wal, history.jsonl,
# session_index.jsonl, sessions/, shell_snapshots/, log/, login.log,
# models_cache.json, cache/, plugins/, tmp/, installation_id, version.json,
# .sandbox_migration.
.codex/*
!.codex/.stow-local-ignore
!.codex/AGENTS.md
!.codex/rules/
!.codex/schemas/
!.codex/skills/
# vendor-managed Codex system skills: regenerated by the CLI, never tracked
.codex/skills/.system/
# belt-and-braces: nothing credential- or state-shaped, at any depth
.codex/**/auth.json
.codex/**/config.toml
.codex/**/*.sqlite*
.codex/**/.env*
.codex/**/__pycache__/
