FROM debian:13-slim

# The recipe hash arrives as `podman build --label lab.recipe.sha256=...`, so
# no profile's Containerfile carries lab-specific ARG or LABEL lines.

ENV DEBIAN_FRONTEND=noninteractive \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        git python3 python3-venv build-essential ca-certificates curl \
        unzip jq procps \
        xvfb x11-utils imagemagick \
        mesa-vulkan-drivers libvulkan1 libgl1 libglx-mesa0 libegl1 \
        libx11-6 libxcursor1 libxinerama1 libxrandr2 libxi6 libxext6 \
        fontconfig libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

COPY lab-shot /usr/local/bin/lab-shot
RUN chmod 755 /usr/local/bin/lab-shot \
    && git config --global --add safe.directory '*'

WORKDIR /work
CMD ["sleep", "infinity"]
