#!/bin/bash
# Block Bash commands that read large files, explain how to keep reading
# Catches cat/head/tail/less/more that bypass the Read hook
#
# Modified from spotify/portal-ai-plugins; see ../upstream-source.md
# Never emit permissionDecision allow: it skips the user's permission prompt.

MIN_LINES="${SHUNT_MIN_LINES:-350}"
case "$MIN_LINES" in ''|*[!0-9]*) MIN_LINES=350 ;; esac

input=$(cat)
cwd=$(echo "$input" | jq -r '.cwd // empty')

harness=claude
if [ "${1:-}" = "--harness" ]; then
  harness="${2:-}"
fi
case "$harness" in claude|codex|copilot) ;; *) exit 0 ;; esac

if [ "$harness" = copilot ]; then
  tool_args=$(echo "$input" | jq -c '.toolArgs // {} | if type == "string" then fromjson? else . end')
  command=$(echo "$tool_args" | jq -r '.command // empty')
else
  command=$(echo "$input" | jq -r '.tool_input.command // empty')
fi
[ -z "$command" ] && exit 0

# Skip piped commands (cat file | grep) — those are targeted reads
echo "$command" | grep -qE '\|' && exit 0

# Skip redirections (cat file > out) — not a read-into-context operation
echo "$command" | grep -qE '>' && exit 0

# Extract file path from read commands, stripping flags (e.g. cat -n, head -100)
file_path=""
if echo "$command" | grep -qE '^(cat|head|tail|less|more) '; then
  # Remove the command name, then strip any flags (-n, -100, --number, etc.)
  args=$(echo "$command" | sed -E 's/^(cat|head|tail|less|more) +//')
  for arg in $args; do
    case "$arg" in
      -*) continue ;;
      *)  file_path=$(echo "$arg" | tr -d '"'"'"); break ;;
    esac
  done
fi

[ -z "$file_path" ] && exit 0
[ -n "$cwd" ] && case "$file_path" in
  /*) ;;
  *) file_path="$cwd/$file_path" ;;
esac
[ ! -f "$file_path" ] && exit 0

lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ' || echo "0")
if [ "$lines" -gt "$MIN_LINES" ]; then
  reason="File is ${lines} lines. Read it in chunks of at most ${MIN_LINES} lines until you have read the full file. Use bash: sed -n 'START,ENDp' FILE, with END-START+1 <= ${MIN_LINES} (start with sed -n '1,${MIN_LINES}p' FILE, then continue at $((MIN_LINES + 1))). Use grep for targeted lookups."
  if [ -n "${PORTAL_CLI_BIN:-}" ] || command -v portal-cli >/dev/null 2>&1; then
    reason="$reason For a delegated summary, you can also use /bulk-reader."
  fi
  if [ "$harness" = copilot ]; then
    jq -cn --arg reason "$reason" \
      '{permissionDecision: "deny", permissionDecisionReason: $reason}'
  else
    jq -cn --arg reason "$reason" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason}}'
  fi
fi
