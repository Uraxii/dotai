#!/usr/bin/env python3
"""Command line for podman-sandbox: a throwaway podman container per agent.

    lab up NAME [--repo PATH] [--profile NAME] [--branch BRANCH] [--port N]
    lab exec NAME ARGV...
    lab shot NAME [--out PATH] [--seconds N] [--allow-blank] [-- ARGV...]
    lab down NAME
    lab check [--profile NAME]

Python standard library only, forever. No pip dependency.

INVARIANT: every subprocess call in this skill takes a `list[str]` and never
`shell=True`. This file's `git` function and `lab_container.podman` are the
only two places a subprocess starts. A caller who wants a shell passes
`["bash", "-lc", script]` as argv and owns that script.

This file is the shell of the program: it parses argv, reads host git facts,
calls the converge functions, and prints one machine-readable line. The
decisions live in `lab_profile` and `lab_container`.
"""

from __future__ import annotations

import argparse
import logging
import platform
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

import lab_container
import lab_profile

SHOT_DIR_SUBPATH = Path(".nikki-agents") / "podman-sandbox" / "shots"
SHOT_CONTAINER_PATH = "/tmp/lab-shot.png"
DEFAULT_PROFILE = "base"
DEFAULT_SHOT_SECONDS = 30
BLANK_MAX_COLORS = 2

SHOT_COMMAND = "lab-shot"
SHOT_COMMAND_NAME = "shot"
THROWAWAY_DISPLAY = ":100"
HEAD_DIGITS = 8
MACOS_SHARE_WARNING = (
    "on macOS the repository must sit inside a directory the podman machine "
    "shares, $HOME by default"
)


class UsageError(Exception):
    """The arguments cannot be turned into a command. Exit 2 with this text."""


def git(args: list[str], repo: Path | None = None) -> str:
    """Run `git` with `args` and return stdout, stripped.

    Raises UsageError on a non-zero exit, because every git call here reads
    a host fact the user named: a repo root, a branch, a commit.
    """
    done = subprocess.run(["git"] + args, capture_output=True, text=True,
                          check=False,
                          cwd=str(repo) if repo is not None else None)
    if done.returncode != 0:
        detail = done.stderr.strip() or done.stdout.strip()
        raise UsageError(f"git {' '.join(args)} failed: {detail}")
    return done.stdout.strip()


def resolve_repo(given: str | None) -> Path:
    """Return the absolute repo root, defaulting to the working directory's.

    Raises UsageError when no path was given and the working directory is
    not inside a git repository.
    """
    start = Path(given).expanduser() if given else Path.cwd()
    if not start.is_dir():
        raise UsageError(f"{start} is not a directory")
    return Path(git(["rev-parse", "--show-toplevel"], start)).resolve()


def resolve_git_common_dir(repo: Path) -> Path:
    """Return the absolute git directory shared by every linked worktree."""
    return Path(git([
        "rev-parse", "--path-format=absolute", "--git-common-dir"
    ], repo)).resolve()


def resolve_branch(repo: Path, given: str | None) -> tuple[str, str]:
    """Return (branch, head sha) for `given`, defaulting to the repo's HEAD."""
    branch = given or git(["rev-parse", "--abbrev-ref", "HEAD"], repo)
    return branch, git(["rev-parse", "--verify", branch], repo)


def default_shot_path(repo: Path, name: str) -> Path:
    """Return `<repo>/.nikki-agents/podman-sandbox/shots/<name>-<UTC ISO>.png`.

    A timestamped default means an agent never overwrites the screenshot it
    took a minute ago, and never has to invent a path.
    """
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H-%M-%SZ")
    return repo / SHOT_DIR_SUBPATH / f"{name}-{stamp}.png"


def require_spec(lab: lab_container.Lab) -> lab_container.LabSpec:
    """Return the lab's stored spec, or explain that the lab is not up."""
    spec = lab_container.read_spec(lab)
    if spec is None:
        raise UsageError(f"no lab named {lab.name}. Run `lab up {lab.name}` first")
    return spec


def command_up(args: argparse.Namespace) -> int:
    """Converge a lab and print one line naming everything an agent needs.

    Prints to stdout:

        lab name=demo container=lab-demo image=podman-sandbox/base:latest
        work=/work/myrepo head=1a2b3c4d port=6551 changed=2

    as one line, with `port=` omitted when the profile publishes none.
    Progress goes to stderr, so stdout stays one parseable line.

    Converge order: build the image, recreate the container if the spec
    changed, start it, sync the clone, run the profile's setup, wait for the
    profile's ready check. A second run with no input change prints
    `changed=0` and rebuilds nothing. The ready check never counts as a
    change, because polling alters nothing.
    """
    lab_container.require_podman()
    repo = resolve_repo(args.repo)
    git_common_dir = resolve_git_common_dir(repo)
    branch, head = resolve_branch(repo, args.branch)
    profile = lab_profile.load(args.profile, repo)
    base = None
    if profile.name != DEFAULT_PROFILE:
        base = lab_profile.load(DEFAULT_PROFILE, repo)
    port = args.port if args.port is not None else profile.port
    lab = lab_container.Lab(args.name)
    spec = lab_container.LabSpec(
        repo=str(repo),
        branch=branch,
        profile=profile.name,
        port=port,
        image=profile.image,
        recipe_sha256=lab_container.recipe_sha256(profile, base),
        git_common_dir=str(git_common_dir),
    )
    changed = 0
    logging.info("converging image %s", profile.image)
    changed += int(lab_container.build_image(profile, base))
    created = lab_container.read_spec(lab) != spec
    if created:
        logging.info("creating container %s", lab.container)
        lab_container.create_container(lab, spec, repo, git_common_dir)
        changed += 1
    started = lab_container.start_container(lab)
    changed += int(started)
    clone = lab.clone_path(repo)
    logging.info("syncing clone %s to %s", clone, head[:HEAD_DIGITS])
    changed += int(lab_container.sync_clone(lab, repo, branch, head))
    changed += int(lab_container.run_setup(lab, profile, clone, created or started))
    lab_container.wait_ready(lab, profile)
    report = lab_container.ConvergeReport(lab, spec, clone, head, changed)
    print(format_up(report))
    return 0


def format_up(report: lab_container.ConvergeReport) -> str:
    """Return `up`'s single stdout line for a finished converge."""
    fields = [
        f"name={report.lab.name}",
        f"container={report.lab.container}",
        f"image={report.spec.image}",
        f"work={report.clone_path}",
        f"head={report.head[:HEAD_DIGITS]}",
    ]
    if report.spec.port is not None:
        fields.append(f"port={report.spec.port}")
    fields.append(f"changed={report.changed}")
    return "lab " + " ".join(fields)


def command_exec(args: argparse.Namespace) -> int:
    """Run a command in the lab and return its exit code.

    The working directory is the private clone, so a caller never writes
    `cd`. Arguments after NAME are passed through as argv, unparsed.
    """
    argv = passthrough_argv(args.argv)
    if not argv:
        raise UsageError("exec needs a command to run")
    lab = lab_container.Lab(args.name)
    spec = require_spec(lab)
    workdir = lab.clone_path(Path(spec.repo))
    return lab_container.exec_argv(lab, argv, workdir)


def passthrough_argv(argv: list[str]) -> list[str]:
    """Return `argv` with one leading `--` separator dropped."""
    return argv[1:] if argv[:1] == ["--"] else argv


def split_shot_argv(argv: list[str]) -> tuple[list[str], list[str]]:
    """Split `shot`'s own flags from the command it photographs.

    argparse's REMAINDER swallows a flag written after the lab name, so
    `shot --seconds 60 -- app` needs the separator honoured before parsing.
    `exec` takes no flags of its own, so its REMAINDER keeps an inner `--`
    for the command it runs.
    """
    if argv[:1] == [SHOT_COMMAND_NAME] and "--" in argv:
        cut = argv.index("--")
        return argv[:cut], argv[cut + 1:]
    return argv, []


def command_shot(args: argparse.Namespace) -> int:
    """Screenshot the lab's virtual display and copy the PNG to the host.

    With no `--` argv, grabs the persistent display a profile's setup hook
    started, so a running editor is photographed and left running. With
    `-- ARGV`, runs `lab-shot` which starts its own throwaway display,
    leaving the persistent one untouched.

    Prints:

        shot path=/abs/path.png size=1280x720 stddev=10497.7 colors=4093
        bytes=223095

    as one line. Exits 1 when `colors` is 2 or fewer, which means nothing
    rendered on the display. A screenshot of a window that never painted,
    reported as a success, is the failure this command exists to prevent;
    `--allow-blank` turns the gate off for a caller that wants such a frame.

    The numbers are the proof. Read them; do not open the PNG, because its
    pixels then occupy the agent's context for the rest of the session.
    """
    argv = passthrough_argv(args.argv)
    lab = lab_container.Lab(args.name)
    spec = require_spec(lab)
    repo = Path(spec.repo)
    chosen = Path(args.out).expanduser() if args.out else None
    out = (chosen or default_shot_path(repo, args.name)).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    display = THROWAWAY_DISPLAY if argv else lab_container.PERSISTENT_DISPLAY
    logging.info("capturing display %s", display)
    stats = lab_container.exec_capture(
        lab,
        [SHOT_COMMAND, SHOT_CONTAINER_PATH, display, str(args.seconds)] + argv,
        lab.clone_path(repo),
    )
    lab_container.copy_out(lab, SHOT_CONTAINER_PATH, out)
    size, _, measures = stats.strip().partition(" ")
    print(f"shot path={out} size={size} {measures}")
    if is_blank(measures) and not args.allow_blank:
        blank = (f"FAIL: {out} is blank: {BLANK_MAX_COLORS} colours or "
                 "fewer, so nothing painted")
        print(blank, file=sys.stderr)
        return 1
    return 0


def is_blank(measures: str) -> bool:
    """True when an identify line reports BLANK_MAX_COLORS colours or fewer.

    Counting colours rather than measuring spread, because a display nothing
    painted on is not always uniform. A window that fails to come up can
    leave one dialog box on an otherwise empty screen: two colours, 99% of
    the frame the background, and a standard deviation far from zero. That
    frame passed a `stddev == 0` gate, which is the silent success this
    command exists to prevent. Nothing that really rendered on a 24-bit
    display comes back with two colours; anti-aliasing alone spends more.
    """
    for measure in measures.split():
        key, _, value = measure.partition("=")
        if key == "colors":
            return int(value) <= BLANK_MAX_COLORS
    raise lab_container.LabError(f"lab-shot printed no colors: {measures}")


def command_down(args: argparse.Namespace) -> int:
    """Delete the container and its volume, and print what was removed.

    The clone and any uncommitted work in it are gone. Prints:

        lab down name=demo container=lab-demo volume=lab-demo-work
    """
    lab = lab_container.Lab(args.name)
    lab_container.destroy(lab)
    print(f"lab down name={lab.name} container={lab.container} "
          f"volume={lab.volume}")
    return 0


def command_check(args: argparse.Namespace) -> int:
    """Check this host can run labs, printing one line per check.

    Fails loudly here rather than mysteriously later. Checks, in order:

    - `podman` is on PATH and `podman info` exits 0.
    - The profile resolves to a directory holding a Containerfile, and its
      profile.json parses.
    - The working directory, or `--repo`, is a git repository whose HEAD
      resolves.
    - On Darwin: warns that the repo path must lie inside a directory the
      podman machine shares, because a bind mount of an unshared path
      silently mounts nothing.

    Prints `ok: <what>` or `FAIL: <what>: <why>` per check, and exits 1 when
    any check failed. Builds no image and starts no container.

    It does not test whether the profile's port is free. A port free now can
    be taken by the time `up` runs, and podman names the collision itself at
    the only moment that matters.
    """
    results = [report_check("podman", describe_podman),
               report_check("repository", lambda: describe_repo(args.repo)),
               report_check(f"profile {args.profile}",
                            lambda: describe_profile(args.profile, args.repo))]
    if platform.system() == "Darwin":
        print(f"ok: macos: {MACOS_SHARE_WARNING}")
    return 0 if all(results) else 1


def report_check(what: str, probe) -> bool:
    """Print one `ok:` or `FAIL:` line for `probe`. True when it passed."""
    try:
        print(f"ok: {what}: {probe()}")
        return True
    except (UsageError, OSError, lab_container.LabError,
            lab_profile.ProfileError) as err:
        print(f"FAIL: {what}: {err}")
        return False


def describe_podman() -> str:
    """Return podman's version, having proved the daemonless engine answers."""
    version = lab_container.require_podman()
    lab_container.podman(["info", "--format", "{{.Host.Arch}}"])
    return version


def describe_repo(given: str | None) -> str:
    """Return the repo root and head for `given`, or the working directory."""
    repo = resolve_repo(given)
    branch, head = resolve_branch(repo, None)
    return f"{repo} {branch} {head[:HEAD_DIGITS]}"


def describe_profile(name: str, given: str | None) -> str:
    """Return where profile `name` resolves and the hash of its directory."""
    try:
        repo = resolve_repo(given)
    except UsageError:
        repo = Path.cwd()
    profile = lab_profile.load(name, repo)
    digest = profile.recipe_sha256[:HEAD_DIGITS]
    return f"{profile.directory} recipe={digest}"


def build_parser() -> argparse.ArgumentParser:
    """Return the parser for every subcommand."""
    parser = argparse.ArgumentParser(prog="lab", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    up = sub.add_parser("up", help="converge a lab and print its facts")
    up.add_argument("name")
    up.add_argument("--repo", help="repository to mount and clone")
    up.add_argument("--profile", default=DEFAULT_PROFILE)
    up.add_argument("--branch", help="branch to check out in the clone")
    up.add_argument("--port", type=int, help="override the published port")
    up.set_defaults(run=command_up)

    run_in = sub.add_parser("exec", help="run a command in the clone")
    run_in.add_argument("name")
    run_in.add_argument("argv", nargs=argparse.REMAINDER)
    run_in.set_defaults(run=command_exec)

    shot = sub.add_parser(SHOT_COMMAND_NAME, help="screenshot the lab's display")
    shot.add_argument("name")
    shot.add_argument("--out", help="where to write the PNG on the host")
    shot.add_argument("--seconds", type=int, default=DEFAULT_SHOT_SECONDS)
    shot.add_argument("--allow-blank", action="store_true",
                      help="accept a frame nothing painted on")
    shot.set_defaults(run=command_shot, argv=[])

    down = sub.add_parser("down", help="delete the container and its volume")
    down.add_argument("name")
    down.set_defaults(run=command_down)

    check = sub.add_parser("check", help="check this host can run labs")
    check.add_argument("--repo")
    check.add_argument("--profile", default=DEFAULT_PROFILE)
    check.set_defaults(run=command_check)
    return parser


def main(argv: list[str]) -> int:
    """Dispatch one subcommand, turning UsageError into exit 2."""
    logging.basicConfig(stream=sys.stderr, format="lab: %(message)s",
                        level=logging.INFO)
    own, passthrough = split_shot_argv(argv)
    args = build_parser().parse_args(own)
    if passthrough:
        args.argv = passthrough
    try:
        return args.run(args)
    except (UsageError, lab_profile.ProfileError) as err:
        print(f"lab: {err}", file=sys.stderr)
        return 2
    except lab_container.LabError as err:
        print(f"lab: {err}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
