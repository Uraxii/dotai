#!/bin/bash
# Block Bash commands that read large files, explain how to keep reading
# Catches cat/head/tail/less/more that bypass the Read hook
#
# Modified from spotify/portal-ai-plugins; see ../upstream-source.md
# Never emit permissionDecision allow: it skips the user's permission prompt.

MIN_LINES="${SHUNT_MIN_LINES:-350}"
case "$MIN_LINES" in ''|*[!0-9]*) MIN_LINES=350 ;; esac

# hook-json.awk reads the hook input, so the hook needs only bash and awk, and Git
# Bash runs it on Windows.
case "${BASH_SOURCE[0]}" in
  */*) hooks_dir=${BASH_SOURCE[0]%/*} ;;
  *) hooks_dir=. ;;
esac
# The value at a JSON path in the hook input, as jq -r '.path // empty' prints
# it. A second path reads inside that member first, parsing it when it is a
# JSON string, as Copilot sends toolArgs.
field() {
  printf '%s' "$input" | LC_ALL=C JSON_MODE=get JSON_PATH="$1" JSON_VIA="${2-}" awk -f "$hooks_dir/hook-json.awk"
}
deny() {
  local reason
  reason=$(LC_ALL=C JSON_MODE=quote JSON_TEXT="$1" awk -f "$hooks_dir/hook-json.awk")
  if [ "$harness" = copilot ]; then
    printf '{"permissionDecision":"deny","permissionDecisionReason":%s}\n' "$reason"
  else
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":%s}}\n' "$reason"
  fi
}

input=$(cat)
cwd=$(field /cwd)

harness=claude
if [ "${1:-}" = "--harness" ]; then
  harness="${2:-}"
fi
case "$harness" in claude|codex|copilot) ;; *) exit 0 ;; esac

if [ "$harness" = copilot ]; then
  command=$(field /command /toolArgs)
else
  command=$(field /tool_input/command)
fi
[ -z "$command" ] && exit 0

# Skip piped commands (cat file | grep) — those are targeted reads
echo "$command" | grep -qE '\|' && exit 0

# Skip redirections (cat file > out) — not a read-into-context operation
echo "$command" | grep -qE '>' && exit 0

# Extract file path from read commands, stripping flags (e.g. cat -n, head -100)
file_path=""
if echo "$command" | grep -qE '^(cat|head|tail|less|more) '; then
  # Remove the command name, then strip any flags (-n, -100, --number, etc.)
  args=$(echo "$command" | sed -E 's/^(cat|head|tail|less|more) +//')
  for arg in $args; do
    case "$arg" in
      -*) continue ;;
      *)  file_path=$(echo "$arg" | tr -d '"'"'"); break ;;
    esac
  done
fi

[ -z "$file_path" ] && exit 0
[ -n "$cwd" ] && case "$file_path" in
  /*) ;;
  *) file_path="$cwd/$file_path" ;;
esac
case "/$file_path" in
  */../*) ;;
  */.handoffs/*|*/handoffs/*) exit 0 ;;
esac
[ ! -f "$file_path" ] && exit 0

lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ' || echo "0")
if [ "$lines" -gt "$MIN_LINES" ]; then
  reason="Delegate via the bulk-reader skill for understanding or questions about this ${lines}-line file, including answers with line citations. Keep the file out of the main agent's context; the reader returns the citations. If you are already the reader subagent, do not delegate again. Use main-agent chunks only for edits, explicit requests for exact content, or when no subagent tool exists. For those cases or subagent reads:"
  if [ "$harness" = claude ] && [ -n "$(field /agent_id)" ]; then
    reason="You are the reader subagent; do not delegate again. File is ${lines} lines."
  fi
  reason="$reason Read it in chunks of at most ${MIN_LINES} lines until you have read the full file. Use bash: sed -n 'START,ENDp' FILE, with END-START+1 <= ${MIN_LINES} (start with sed -n '1,${MIN_LINES}p' FILE, then continue at $((MIN_LINES + 1))). Use grep for targeted lookups."
  deny "$reason"
fi
