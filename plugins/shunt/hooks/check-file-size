#!/bin/bash
# Block full-file reads on large files, explain how to keep reading
# Self-contained: all routing logic lives here, no CLAUDE.md needed
#
# Modified from spotify/portal-ai-plugins; see ../upstream-source.md
# Never emit permissionDecision allow: it skips the user's permission prompt.

MIN_LINES="${SHUNT_MIN_LINES:-350}"
case "$MIN_LINES" in ''|*[!0-9]*) MIN_LINES=350 ;; esac

input=$(cat)
cwd=$(echo "$input" | jq -r '.cwd // empty')

harness=claude
if [ "${1:-}" = "--harness" ]; then
  harness="${2:-}"
fi
case "$harness" in claude|codex|copilot) ;; *) exit 0 ;; esac

if [ "$harness" = copilot ]; then
  tool_args=$(echo "$input" | jq -c '.toolArgs // {} | if type == "string" then fromjson? else . end')
  file_path=$(echo "$tool_args" | jq -r '.path // empty')
  offset=$(echo "$tool_args" | jq -r '.view_range // empty')
  limit="$offset"
else
  file_path=$(echo "$input" | jq -r '.tool_input.file_path // empty')
  offset=$(echo "$input" | jq -r '.tool_input.offset // empty')
  limit=$(echo "$input" | jq -r '.tool_input.limit // empty')
fi

# Allow targeted reads (offset or limit set) — Claude already knows what it needs
if [ -n "$offset" ] || [ -n "$limit" ]; then
  exit 0
fi

[ -n "$cwd" ] && case "$file_path" in
  /*) ;;
  *) file_path="$cwd/$file_path" ;;
esac

# Allow if file doesn't exist or path is empty
if [ -z "$file_path" ] || [ ! -f "$file_path" ]; then
  exit 0
fi

# Allow small files — delegation overhead isn't worth it
lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ' || echo "0")
if [ "$lines" -le "$MIN_LINES" ]; then
  exit 0
fi

reason="Delegate via the bulk-reader skill for understanding or questions about this ${lines}-line file, including answers with line citations. Keep the file out of the main agent's context; the reader returns the citations. If you are already the reader subagent, do not delegate again. Use main-agent chunks only for edits, explicit requests for exact content, or when no subagent tool exists. For those cases or subagent reads:"
if [ "$harness" = claude ] && [ -n "$(echo "$input" | jq -r '.agent_id // empty')" ]; then
  reason="You are the reader subagent; do not delegate again. File is ${lines} lines."
fi
reason="$reason Read it in chunks of at most ${MIN_LINES} lines until you have read the full file."
case "$harness" in
  claude)
    reason="$reason Use Read with offset and limit (start with offset=1, limit=${MIN_LINES}, then advance offset by ${MIN_LINES})."
    ;;
  copilot)
    reason="$reason Use view with view_range [start, end] (inclusive; start with [1, ${MIN_LINES}], then continue at $((MIN_LINES + 1)))."
    ;;
esac
reason="$reason Or use bash: sed -n 'START,ENDp' FILE, with END-START+1 <= ${MIN_LINES}. Use grep for targeted lookups."
if [ "$harness" = copilot ]; then
  jq -cn --arg reason "$reason" \
    '{permissionDecision: "deny", permissionDecisionReason: $reason}'
else
  jq -cn --arg reason "$reason" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason}}'
fi
