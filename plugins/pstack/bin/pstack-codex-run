#!/usr/bin/env python3
"""Start one Codex run for an agent run directory and print how it ended.

Usage: pstack-codex-run <RUN>

RUN is an absolute run directory made by `create_agent_run.py`. Its
`brief.md` frontmatter names the kind, the worktree, and an optional model.
The output is the keyed lines the owner reads: `fallback`, `command`,
`exit code`, and `reason` on a fallback. Codex's own output goes to
`<RUN>/codex-exec.log`.
"""

from __future__ import annotations

import os
import shlex
import shutil
import subprocess
import sys
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path


__all__ = ["Launch", "RunRefused", "main", "plan_launch"]

RUNS_DIR_NAME = ".agent-runs"
RULES_NAME = "pstack-codex-writer.rules"
DEFAULT_CODEX_HOME = "~/.codex-agent"
NO_HELPER_AGENTS = ("-c", "agents.enabled=false")


class RunRefused(Exception):
    """The run cannot start. The message is one plain sentence."""


@dataclass(frozen=True)
class Kind:
    sandbox_flags: tuple[str, ...]
    worktree_in_runs_root: bool
    run_dir_writable: bool
    commit_rules: bool


KINDS: Mapping[str, Kind] = {
    "writer": Kind(
        sandbox_flags=("-s", "workspace-write"),
        worktree_in_runs_root=True,
        run_dir_writable=True,
        commit_rules=True,
    ),
    "reviewer": Kind(
        sandbox_flags=("-s", "read-only", "--ignore-rules"),
        worktree_in_runs_root=False,
        run_dir_writable=False,
        commit_rules=False,
    ),
}


@dataclass(frozen=True)
class RulesCopy:
    source: Path
    target: Path


@dataclass(frozen=True)
class Launch:
    kind: Kind
    run: Path
    worktree: Path
    argv: tuple[str, ...]
    codex_home: Path
    rules: RulesCopy | None


def runs_root(run: str, configured: str | None) -> str | None:
    """`AGENT_RUNS_DIR` when set, else RUN's prefix through `.agent-runs`."""
    if configured:
        return os.path.abspath(configured)
    segments = run.split("/")
    if RUNS_DIR_NAME not in segments:
        return None
    return "/".join(segments[: segments.index(RUNS_DIR_NAME) + 1])


def is_strictly_inside(path: str, root: str | None) -> bool:
    return root is not None and path.startswith(root.rstrip("/") + "/")


def check_run(raw: str, configured_root: str | None) -> tuple[Path, str]:
    """RUN as a normalized path, and the runs root it sits in."""
    if not os.path.isabs(raw):
        raise RunRefused(f"the run directory {raw} is not an absolute path")
    run = os.path.normpath(raw)
    root = runs_root(run, configured_root)
    if not is_strictly_inside(run, root):
        raise RunRefused(
            f"the run directory {run} is not inside the runs root "
            f"({RUNS_DIR_NAME} or AGENT_RUNS_DIR)"
        )
    if not os.path.isdir(run):
        raise RunRefused(f"the run directory {run} does not exist")
    return Path(run), root


def parse_frontmatter(text: str) -> dict[str, str]:
    lines = text.splitlines()
    if not lines or lines[0] != "---" or "---" not in lines[1:]:
        raise RunRefused("brief.md has no frontmatter between --- lines")
    fields = {}
    for line in lines[1 : lines.index("---", 1)]:
        key, separator, value = line.partition(": ")
        if separator:
            fields[key.strip()] = value.strip()
    return fields


def plan_launch(
    fields: Mapping[str, str],
    run: Path,
    root: str,
    codex_home: Path,
    script_dir: Path,
) -> Launch:
    """The Codex command and setup for a brief, before touching the disk."""
    kind_name = fields.get("kind")
    kind = KINDS.get(kind_name or "")
    if kind is None:
        raise RunRefused(f"brief.md kind {kind_name} is not writer or reviewer")
    raw_worktree = fields.get("worktree")
    if not raw_worktree or not os.path.isabs(raw_worktree):
        raise RunRefused("brief.md names no absolute worktree")
    worktree = os.path.normpath(raw_worktree)
    if kind.worktree_in_runs_root and not is_strictly_inside(worktree, root):
        raise RunRefused(
            f"the writer worktree {worktree} is not inside the runs root {root}"
        )
    model = fields.get("model")
    argv = (
        "codex",
        "exec",
        *(("-m", model) if model else ()),
        *kind.sandbox_flags,
        *NO_HELPER_AGENTS,
        "-C",
        worktree,
        *(("--add-dir", str(run)) if kind.run_dir_writable else ()),
        "-o",
        str(run / "report.md"),
        "-",
    )
    rules = None
    if kind.commit_rules:
        target = codex_home / "rules" / RULES_NAME
        rules = RulesCopy(script_dir / RULES_NAME, target)
    return Launch(kind, run, Path(worktree), argv, codex_home, rules)


def prepare(
    raw_run: str, environ: Mapping[str, str], script_dir: Path
) -> Launch:
    """Validate RUN and its brief against the disk, then plan the launch."""
    run, root = check_run(raw_run, environ.get("AGENT_RUNS_DIR"))
    try:
        brief = (run / "brief.md").read_text(encoding="utf-8")
    except OSError:
        raise RunRefused(f"{run}/brief.md is missing or unreadable") from None
    except UnicodeDecodeError:
        raise RunRefused(f"{run}/brief.md cannot be read as UTF-8 text") from None
    home = environ.get("PSTACK_CODEX_HOME") or DEFAULT_CODEX_HOME
    codex_home = Path(os.path.expanduser(home))
    fields = parse_frontmatter(brief)
    launch = plan_launch(fields, run, root, codex_home, script_dir)
    worktree = launch.worktree
    if launch.kind.worktree_in_runs_root:
        if not (worktree / ".git").exists():
            raise RunRefused(f"the writer worktree {worktree} has no .git")
    elif not worktree.is_dir():
        raise RunRefused(f"the worktree {worktree} does not exist")
    return launch


def install_rules(rules: RulesCopy) -> None:
    """Copy the bundled rules into CODEX_HOME, replacing the old file atomically.

    A regular file, because Codex skips a symlinked rules file. The temp name
    does not end in `.rules`, so a crash never leaves a half-written rule.
    """
    rules.target.parent.mkdir(parents=True, exist_ok=True)
    temporary = rules.target.with_name(f".{rules.target.name}.{os.getpid()}.tmp")
    temporary.unlink(missing_ok=True)
    shutil.copyfile(rules.source, temporary)
    os.replace(temporary, rules.target)


@dataclass(frozen=True)
class Outcome:
    command: str | None
    exit_code: int | None
    reason: str | None

    def lines(self) -> str:
        if self.reason is None:
            return f"fallback: none\ncommand: {self.command}\nexit code: 0"
        code = "(none)" if self.exit_code is None else self.exit_code
        return (
            "fallback: claude\n"
            f"command: {self.command or '(none)'}\n"
            f"exit code: {code}\n"
            f"reason: {self.reason}"
        )


def refused(reason: str) -> Outcome:
    return Outcome(None, None, reason)


def run_codex(launch: Launch, log_path: Path) -> Outcome:
    """Preflight, then exec, stopping at the first command that fails."""
    env = {**os.environ, "CODEX_HOME": str(launch.codex_home)}
    brief = launch.run / "brief.md"
    login_hint = f"log in once with CODEX_HOME={launch.codex_home} codex login"
    steps = (
        (("codex", "--version"), Path(os.devnull), ""),
        (("codex", "login", "status"), Path(os.devnull), f"; {login_hint}"),
        (launch.argv, brief, f"; see {log_path}"),
    )
    with log_path.open("w") as log:
        for argv, stdin_path, hint in steps:
            command = shlex.join(argv)
            with stdin_path.open("rb") as stdin:
                try:
                    code = subprocess.run(
                        argv, stdin=stdin, stdout=log, stderr=log, env=env
                    ).returncode
                except FileNotFoundError:
                    return Outcome(command, None, "codex is not on PATH")
            if code != 0:
                name = " ".join(argv[:2])
                return Outcome(command, code, f"{name} exited {code}{hint}")
    return Outcome(shlex.join(launch.argv), 0, None)


def start(args: Sequence[str]) -> Outcome:
    if len(args) != 1:
        return refused("pstack-codex-run takes exactly one run directory")
    try:
        launch = prepare(args[0], os.environ, Path(__file__).resolve().parent)
    except RunRefused as error:
        return refused(str(error))
    try:
        if launch.rules:
            install_rules(launch.rules)
        return run_codex(launch, launch.run / "codex-exec.log")
    except OSError as error:
        return refused(f"the run could not be set up: {error}")


def main() -> int:
    outcome = start(sys.argv[1:])
    print(outcome.lines())
    return 0 if outcome.reason is None else 1


if __name__ == "__main__":
    sys.exit(main())
