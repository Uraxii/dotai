#!/usr/bin/env python3
"""cbm <tool> ['<json>'] -> codebase-memory-mcp cli --quiet <tool>, JSON on stdin.

The arguments default to `{}` and go on stdin, the form the binary supports;
passing them as an argv word is deprecated upstream. `--quiet` keeps stderr to
errors, which pass straight through. The exit status is the binary's own, so
a caller can branch on it. JSON stdout is pretty-printed; anything else, such
as the compact text tree most tools answer in by default, passes through
unchanged.

Python standard library only, forever. No pip dependency.
"""

from __future__ import annotations

import json
import subprocess
import sys

__all__ = ["main"]

BINARY = "codebase-memory-mcp"
COMMAND = ("cli", "--quiet")
NO_ARGUMENTS = "{}"
INDENT = 2
NOT_FOUND_EXIT = 127


def main(argv: list[str]) -> int:
    """Run one tool, print its answer, and return the binary's status."""
    tool = argv[0] if argv else ""
    arguments = argv[1] if len(argv) > 1 and argv[1] else NO_ARGUMENTS
    try:
        done = subprocess.run([BINARY, *COMMAND, tool], input=arguments,
                              stdout=subprocess.PIPE, text=True, check=False)
    except FileNotFoundError:
        print(f"{BINARY} is not on PATH", file=sys.stderr)
        return NOT_FOUND_EXIT
    try:
        answer = json.loads(done.stdout)
    except json.JSONDecodeError:
        sys.stdout.write(done.stdout)
        return done.returncode
    print(json.dumps(answer, ensure_ascii=False, indent=INDENT))
    return done.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
