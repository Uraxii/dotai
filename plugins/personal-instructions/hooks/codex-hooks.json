{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/inject_instructions.py\" --harness codex --event SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/inject_instructions.py\" --harness codex --event SubagentStart",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
