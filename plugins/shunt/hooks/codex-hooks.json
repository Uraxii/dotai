{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/check-bash-read\" --harness codex",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" check-bash-read --harness codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
