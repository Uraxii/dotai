{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/inject_instructions.sh\" --harness codex --event SessionStart",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" inject_instructions.sh --harness codex --event SessionStart",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/inject_instructions.sh\" --harness codex --event SessionStart --file main-agent-instructions.md",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" inject_instructions.sh --harness codex --event SessionStart --file main-agent-instructions.md",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/inject_instructions.sh\" --harness codex --event SubagentStart",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" inject_instructions.sh --harness codex --event SubagentStart",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
