{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/inject_instructions.sh\" --harness copilot --event SessionStart",
        "powershell": "& \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" inject_instructions.sh --harness copilot --event SessionStart",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/inject_instructions.sh\" --harness copilot --event SessionStart --file main-agent-instructions.md",
        "powershell": "& \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" inject_instructions.sh --harness copilot --event SessionStart --file main-agent-instructions.md",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/inject_instructions.sh\" --harness copilot --event SubagentStart",
        "powershell": "& \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" inject_instructions.sh --harness copilot --event SubagentStart",
        "timeoutSec": 5
      }
    ]
  }
}
