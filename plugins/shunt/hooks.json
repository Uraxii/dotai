{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "view",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/check-file-size\" --harness copilot",
        "powershell": "& \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" check-file-size --harness copilot",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "matcher": "bash",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/check-bash-read\" --harness copilot",
        "powershell": "& \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" check-bash-read --harness copilot",
        "timeoutSec": 5
      }
    ]
  }
}
