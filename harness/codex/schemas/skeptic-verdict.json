{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "BLOCK",
        "NEEDS_TEST",
        "NEEDS_ARCH_REVIEW",
        "NEEDS_REQUIREMENTS"
      ]
    },
    "summary": {
      "type": "string",
      "description": "One or two sentences stating what the change does and why the verdict was chosen."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "claim", "evidence", "confidence"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor"]
          },
          "file": {
            "type": "string",
            "description": "Repository-relative path."
          },
          "line": {
            "type": "integer",
            "description": "1-indexed line the finding anchors to, or 0 if it spans the change."
          },
          "claim": {
            "type": "string",
            "description": "One sentence stating the defect."
          },
          "evidence": {
            "type": "string",
            "description": "Concrete inputs or state leading to the wrong result, or the command output that shows it."
          },
          "confidence": {
            "type": "string",
            "enum": ["VERIFIED", "REASONED", "ASSUMED"],
            "description": "VERIFIED means a command was executed and its output read."
          }
        }
      }
    }
  }
}
